{
  "name": "krunked-quest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Krunked Quest — 60Hz 16-bit neo-retro pixel-art Metroidvania action platformer",
  "scripts": {
    "extract": "tsx tools/extract-assets.ts",
    "oracle": "tsx tools/oracle-dump.ts",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "play": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:assets": "tsx scripts/verify/verify-assets.ts",
    "verify:sim": "tsx scripts/verify/verify-sim.ts",
    "verify": "npm run verify:assets && npm run test && npm run verify:sim",
    "build": "tsc --noEmit && vite build",
    "export:dna": "tsx export-dna.ts"
  },
  "devDependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
